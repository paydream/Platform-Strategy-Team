{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)data/comments.json' ':(exclude)data/tracking.json' ':(exclude)data/stats'",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }
      ]
    }
  ]
}
